            "fields": {
              "url": "http://a"
            },
            "children": []
          }
        },
        {
          "op": "setField",
          "nodeId": "i2",
          "field": "estimate",
          "value": 3
        }
      ]
    },
    {
      "op": "decode",
      "id": "d1",
      "baseline": "genesis",
      "bytes": "e1",
      "version": 1
    }
  ],
  "checks": [
    {
      "kind": "roundTripNodePresent",
      "state": "d1",
      "reencodeVersion": 1,
      "decodeVersion": 3,
      "nodeId": "L2"
    },
    {
      "kind": "roundTripFieldEquals",
      "state": "d1",
      "reencodeVersion": 1,
      "decodeVersion": 3,
      "nodeId": "i2",
      "field": "estimate",
      "value": 3
    },
    {
      "kind": "nodePresent",
      "state": "d1",
      "nodeId": "i2"
    }
  ]
