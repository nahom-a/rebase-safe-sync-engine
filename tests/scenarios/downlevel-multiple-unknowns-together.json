{
  "name": "downlevel-multiple-unknowns-together",
  "description": "one delta carries an unknown node and an unknown field at once; both must be preserved",
  "genesis": {
    "id": "root",
    "type": "root",
    "fields": {},
    "children": [
      {
        "id": "s1",
        "type": "section",
        "fields": {
          "title": "Alpha",
          "status": "open"
        },
        "children": [
          {
            "id": "i1",
            "type": "item",
            "fields": {
              "label": "one",
              "priority": "low"
            },
            "children": []
          },
          {
            "id": "i2",
            "type": "item",
            "fields": {
              "label": "two",
              "priority": "med"
            },
            "children": []
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "op": "encode",
      "id": "e1",
      "baseline": "genesis",
      "version": 3,
      "mutations": [
        {
          "op": "insert",
          "parentId": "s1",
          "index": 0,
          "node": {
            "id": "L2",
